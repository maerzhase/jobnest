{
  "name": "jobnest",
  "version": "0.0.6",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@jobnest/ui": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "0.7.1",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.81.0",
    "write-excel-file": "4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/next": "2.0.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "private": true,
  "scripts": {
    "api:check": "pnpm api:generate && git diff --exit-code -- src/lib/api/bindings.ts",
    "api:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "build": "next build",
    "dev": "next dev",
    "dev:tauri": "tauri dev --config src-tauri/tauri.dev.conf.json -- --bin jobnest_dev",
    "lint": "biome lint .",
    "prebuild": "pnpm api:generate",
    "predev": "pnpm api:generate",
    "pretypecheck": "pnpm api:generate",
    "start": "next start",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module"
}
